# Copy this template to .env.local. Never commit actual credentials.

# Existing Clerk project (or credentials from a new Clerk instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register

# New Supabase project > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server only. Required for the authorized admin voice sync action.
SUPABASE_SERVICE_ROLE_KEY=

# Existing Vapi web/public token, not a Vapi private API token
NEXT_PUBLIC_VAPI_WEB_TOKEN=

# Clerk user ID permitted to run admin maintenance actions
ADMIN_USER_ID=
